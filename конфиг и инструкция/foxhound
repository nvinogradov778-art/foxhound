# ===== HTTP (перенаправление на HTTPS) =====
server {
    listen 80;
    listen [::]:80;
    server_name foxhound-team.ru www.foxhound-team.ru;
    return 301 https://$server_name$request_uri;
}

# ===== HTTPS (основной сайт) =====
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name foxhound-team.ru www.foxhound-team.ru;

    # ===== SSL (пути к сертификатам) =====
    ssl_certificate /etc/letsencrypt/live/foxhound-team.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/foxhound-team.ru/privkey.pem;
    
    # ===== Дополнительные SSL настройки =====
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # ===== Корень сайта =====
    root /var/www/foxhound;
    index index.html;

    # ===== СЖАТИЕ (gzip) =====
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss image/svg+xml;

    # ===== КЕШИРОВАНИЕ СТАТИКИ =====
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg|mp4|webm)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ===== КЕШИРОВАНИЕ HTML =====
    location ~* \.html$ {
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
    }

    # ===== БЕЗ КЕША ДЛЯ JSON =====
    location ~* \.json$ {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
}
